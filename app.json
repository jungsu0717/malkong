{
  "expo": {
    "name": "육아버디",
    "slug": "malkong",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yugabuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yugabuddy.app"
    },
    "android": {
      "package": "com.yugabuddy.app",
      "adaptiveIcon": {
        "backgroundColor": "#C64536",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0E0E11",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "맞춤형 광고를 보여 드리는 데만 써요. 허용하지 않아도 육아버디는 그대로 쓸 수 있어요."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "맞춤형 광고를 보여 드리는 데만 써요. 허용하지 않아도 육아버디는 그대로 쓸 수 있어요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15efccb5-0992-46a2-8f91-01fdf86f0c74"
      }
    },
    "owner": "julian-malkong"
  }
}
